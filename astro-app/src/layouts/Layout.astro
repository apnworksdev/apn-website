---
// https://docs.astro.build/en/guides/view-transitions/
import { ClientRouter } from "astro:transitions";
import Nav from "../components/global/Nav.astro";
import "../styles/global/fonts.css";
import "../styles/global/variables.css";
import "../styles/global/global.css";
import "../styles/global/main.css";
import "../styles/global/nav.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  navItems?: { id: string; label: string; order: number }[];
}

const {
  title,
  description = "APN — Design & Development studio",
  ogImage,
  navItems = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const absoluteOgImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : new URL(ogImage, Astro.site ?? Astro.url).href
  : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    <link
      rel="preload"
      href="/fonts/JJannon-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JJannon-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="container">
      <Nav items={navItems} />
      <aside class="project-hover-preview" data-project-hover-preview hidden>
        <div class="project-hover-preview__inner">
          <img class="project-hover-preview__image" alt="" hidden />
          <div class="project-hover-preview__text">
            <p class="project-hover-preview__excerpt font-s"></p>
          </div>
        </div>
      </aside>
      <main>
        <slot />
      </main>
    </div>

    <script>
      let abortController: AbortController | null = null;

      const bootHoverPreview = () => {
        abortController?.abort();
        abortController = new AbortController();
        const { signal } = abortController;

        const preview = document.querySelector<HTMLElement>("[data-project-hover-preview]");
        const img = preview?.querySelector<HTMLImageElement>(".project-hover-preview__image") ?? null;
        const excerptEl = preview?.querySelector<HTMLElement>(".project-hover-preview__excerpt") ?? null;

        const clearPreview = () => {
          if (!preview) return;
          preview.hidden = true;
          document.documentElement.classList.remove("show-project-hover");
          if (img) {
            img.hidden = true;
            img.removeAttribute("src");
            img.removeAttribute("alt");
          }
          if (excerptEl) excerptEl.textContent = "";
        };

        const setPreviewFromEl = (el: HTMLElement) => {
          if (!preview) return;
          const title = el.dataset.previewTitle ?? "";
          const excerpt = el.dataset.previewExcerpt ?? "";
          const image = el.dataset.previewImage ?? "";

          if (!image && !excerpt) {
            document.documentElement.classList.remove("show-project-hover");
            return;
          }

          preview.hidden = false;
          document.documentElement.classList.add("show-project-hover");
          if (excerptEl) excerptEl.textContent = excerpt;
          if (img) {
            if (image) {
              img.hidden = false;
              img.setAttribute("src", image);
              img.alt = title;
            } else {
              img.hidden = true;
              img.removeAttribute("src");
              img.removeAttribute("alt");
            }
          }
        };

        const getPreviewTarget = (from: EventTarget | null) =>
          (from as Element | null)?.closest?.("[data-project-preview]") as HTMLElement | null;

        document.addEventListener(
          "mouseover",
          (e) => {
            const target = getPreviewTarget(e.target);
            if (target) setPreviewFromEl(target);
          },
          { signal }
        );

        document.addEventListener(
          "mouseout",
          (e) => {
            const toEl = e.relatedTarget as Element | null;
            if (toEl?.closest?.("[data-project-preview]")) return;
            document.documentElement.classList.remove("show-project-hover");
          },
          { signal }
        );

        document.addEventListener(
          "focusin",
          (e) => {
            const target = getPreviewTarget(e.target);
            if (target) setPreviewFromEl(target);
          },
          { signal }
        );

        document.addEventListener(
          "focusout",
          (e) => {
            const toEl = e.relatedTarget as Element | null;
            if (toEl?.closest?.("[data-project-preview]")) return;
            document.documentElement.classList.remove("show-project-hover");
          },
          { signal }
        );

        document.addEventListener("astro:before-preparation", clearPreview, { signal });
      };

      document.addEventListener("astro:page-load", bootHoverPreview);
    </script>
  </body>
</html>
