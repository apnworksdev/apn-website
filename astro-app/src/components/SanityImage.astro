---
import type { Image, ImageAsset } from "@sanity/types";
import { urlFor } from "../utils/image";

interface Props {
  image: Image | ImageAsset;
  alt?: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  image,
  alt = "",
  width = 1200,
  height,
  sizes = "100vw",
  loading = "lazy",
  class: className,
} = Astro.props;

const imageUrl = urlFor(image);
const src = imageUrl.width(Math.min(width, 3200)).url();
const srcsetWidths = [400, 800, 1200, 1600, 2000, 2400, 3200];
const srcset = srcsetWidths.map((w) => `${imageUrl.width(w).url()} ${w}w`).join(", ");

const altText = alt || (typeof image === "object" && "alt" in image && typeof image.alt === "string" ? image.alt : "");
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  alt={altText}
  width={width}
  height={height}
  loading={loading}
  class={className}
/>
