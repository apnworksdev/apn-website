---
import type { Image, ImageAsset } from "@sanity/types";
import { buildSrcSet, urlFor } from "../utils/image";

interface Props {
  image: Image | ImageAsset;
  alt?: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  image,
  alt = "",
  width = 1200,
  height,
  sizes = "100vw",
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  class: className,
} = Astro.props;

const imageUrl = urlFor(image);
const src = imageUrl.width(Math.min(width, 3200)).url();
const srcset = buildSrcSet(image);

const altText = alt || (typeof image === "object" && "alt" in image && typeof image.alt === "string" ? image.alt : "");
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  alt={altText}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  class={className}
/>
