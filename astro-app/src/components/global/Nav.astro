---
import Book from "./Book.astro";
import BookVisuals from "./BookVisuals.astro";

interface NavItem {
  id: string;
  label: string;
  order: number;
}

interface Props {
  items?: NavItem[];
  description?: string;
  variant?: "index" | "project";
}

const { items = [], description, variant = "index" } = Astro.props;

const fallbackItems: NavItem[] = [
  { id: "about-apn", label: "About APN", order: 1 },
  { id: "contact", label: "Contact", order: 2 },
  { id: "latest-project", label: "Latest Project", order: 3 },
  { id: "table-of-works", label: "Table of Works", order: 4 },
  { id: "services-team", label: "Services & Team", order: 5 },
  { id: "clients-collaborators", label: "Clients & Collaborators", order: 6 },
];

const isProjectNav = variant === "project";
const navItems = (items.length > 0 ? items : fallbackItems)
  .slice()
  .sort((a, b) => a.order - b.order);
---

<nav data-nav={isProjectNav ? "project" : "index"}>
  {isProjectNav ? (
    description?.trim() ? (
      <p class="nav__description font-s">{description}</p>
    ) : null
  ) : (
    <>
      <menu>
        {navItems.map((item, itemIndex) => {
          const words = item.label.trim().split(/\s+/).filter(Boolean);
          const num = String(itemIndex + 1).padStart(2, "0");
          return (
            <>
              <button type="button" data-nav-button data-target={item.id}>
                <span class="nav__num font-xs sans">{num}</span>{" "}
                {words.map((word, wordIndex) => (
                  <>
                    {wordIndex > 0 ? " " : null}
                    <span class="nav__word font-s">{word}</span>
                  </>
                ))}
              </button>{" "}
            </>
          );
        })}

        <button type="button" data-nav-button data-target="visuals">
          <span class="nav__num font-xs sans">{String(navItems.length + 1).padStart(2, "0")}</span>{" "}
          <span class="nav__word font-s">Visuals</span>
        </button>
      </menu>
      <div class="nav__underlines" data-nav-underlines aria-hidden="true"></div>
    </>
  )}
  <div class="book__indications">
    {isProjectNav ? (
      <button type="button" class="nav__back" data-nav-back aria-label="Go to the previous page">
        <Book />
      </button>
    ) : (
      <>
        <div class="nav__visuals-book" data-visuals-toggle>
          <Book />
          <BookVisuals />
        </div>
        <button
          type="button"
          class="nav__visuals-mobile"
          data-visuals-toggle
          aria-pressed="false"
          aria-label="View featured visuals"
        >
          <span class="nav__visuals-open font-s">Visuals</span>
          <span class="nav__visuals-close font-s">Close</span>
        </button>
      </>
    )}
    {isProjectNav ? (
      <div class="indications font-xs sans hide-mobile">
        Press 'B' on your keyboard to go to the previous page.
      </div>
    ) : (
      <div class="indications font-xs sans hide-mobile">
        Press 'F' on your keyboard to view the featured work. Press 'T' to return to the text page.
      </div>
    )}
  </div>
</nav>

<script>
  let abortController: AbortController | null = null;

  const bootNav = () => {
    abortController?.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    const navButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-nav-button]")
    );

    const navRoot = document.querySelector<HTMLElement>("[data-nav]");
    const underlineLayer = document.querySelector<HTMLElement>("[data-nav-underlines]");
    const isProjectNav = navRoot?.dataset.nav === "project";

    const goBack = () => {
      if (window.history.length > 1) window.history.back();
      else window.location.assign("/");
    };

    document.querySelectorAll<HTMLElement>("[data-nav-back]").forEach((el) => {
      el.addEventListener("click", goBack, { signal });
    });

    const syncActiveUnderline = () => {
      if (!navRoot || !underlineLayer) return;

      const activeButton = navButtons.find((btn) => btn.classList.contains("active"));
      underlineLayer.replaceChildren();
      if (!activeButton) return;

      const parts = Array.from(
        activeButton.querySelectorAll<HTMLElement>(".nav__num, .nav__word")
      );
      if (parts.length === 0) return;

      const navRect = navRoot.getBoundingClientRect();

      // Group parts that sit on the same visual line (wrapped labels get one bar per line)
      const lines: HTMLElement[][] = [];
      for (const part of parts) {
        const top = Math.round(part.getBoundingClientRect().top);
        const line = lines.find((group) => {
          const groupTop = Math.round(group[0].getBoundingClientRect().top);
          return Math.abs(groupTop - top) <= 4;
        });
        if (line) line.push(part);
        else lines.push([part]);
      }

      for (const line of lines) {
        const rects = line.map((el) => el.getBoundingClientRect());
        const left = Math.min(...rects.map((r) => r.left)) - navRect.left;
        const right = Math.max(...rects.map((r) => r.right)) - navRect.left;
        const bottom = Math.max(...rects.map((r) => r.bottom)) - navRect.top;

        const bar = document.createElement("span");
        bar.className = "nav__underline";
        bar.style.left = `${left}px`;
        bar.style.width = `${Math.max(0, right - left)}px`;
        bar.style.top = `${bottom - 1}px`;
        underlineLayer.appendChild(bar);
      }

      // Next frame so the bar can transition in after layout
      requestAnimationFrame(() => {
        underlineLayer.querySelectorAll(".nav__underline").forEach((el) => {
          el.classList.add("is-on");
        });
      });
    };

    const setActiveTarget = (id: string) => {
      navButtons.forEach((btn) => btn.classList.remove("active"));
      navButtons.forEach((btn) => {
        if (btn.dataset.target === id) btn.classList.add("active");
      });
      syncActiveUnderline();
    };

    let scheduleUpdate = () => {};

    navButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const targetId = button.dataset.target;
          if (!targetId) return;

          if (targetId === "visuals") {
            toggleVisuals();
            return;
          }

          document.documentElement.classList.remove("show-visuals");
          const target = document.getElementById(targetId);
          target?.scrollIntoView({ behavior: "smooth", block: "center" });
          setActiveTarget(targetId);
        },
        { signal }
      );
    });

    const syncVisualsToggle = () => {
      const showing = document.documentElement.classList.contains("show-visuals");
      document.querySelectorAll<HTMLElement>("[data-visuals-toggle]").forEach((el) => {
        el.setAttribute("aria-pressed", showing ? "true" : "false");
        el.setAttribute("aria-label", showing ? "Close featured visuals" : "View featured visuals");
      });
    };

    const toggleVisuals = () => {
      const root = document.documentElement;
      const wasShowing = root.classList.contains("show-visuals");
      root.classList.toggle("show-visuals");
      if (wasShowing) scheduleUpdate();
      else setActiveTarget("visuals");
      syncVisualsToggle();
    };

    const hideVisuals = () => {
      const root = document.documentElement;
      if (!root.classList.contains("show-visuals")) return;
      root.classList.remove("show-visuals");
      scheduleUpdate();
      syncVisualsToggle();
    };

    document.querySelectorAll<HTMLElement>("[data-visuals-toggle]").forEach((el) => {
      el.addEventListener("click", () => toggleVisuals(), { signal });
    });
    syncVisualsToggle();

    document.addEventListener(
      "click",
      (e) => {
        if (!document.documentElement.classList.contains("show-visuals")) return;
        const target = e.target as Element | null;
        if (!target) return;
        if (target.closest("[data-visuals-toggle]") || target.closest("[data-nav]")) return;
        if (target.closest(".featured-carousel__item__content")) return;
        hideVisuals();
      },
      { signal }
    );

    window.addEventListener(
      "keydown",
      (e) => {
        const target = e.target as HTMLElement | null;
        const tag = target?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select" || target?.isContentEditable)
          return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        const key = e.key.toLowerCase();
        if (isProjectNav) {
          if (key === "b") {
            e.preventDefault();
            goBack();
          }
          return;
        }
        if (key === "f") {
          e.preventDefault();
          toggleVisuals();
        } else if (key === "t") {
          e.preventDefault();
          hideVisuals();
        }
      },
      { signal }
    );

    const targetIds = Array.from(
      new Set(
        navButtons
          .map((b) => b.dataset.target)
          .filter((t): t is string => Boolean(t) && t !== "visuals")
      )
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-nav-section]")
    ).filter((section) => Boolean(section.id) && targetIds.includes(section.id));

    if (sections.length > 0) {
      let rafId = 0;
      let lastActiveId: string | null = null;

      const applyActive = (id: string) => {
        if (id === lastActiveId) return;
        lastActiveId = id;
        setActiveTarget(id);
      };

      /**
       * Activate by scrollY thresholds derived from section tops.
       * Trailing sections are remapped into the reachable scroll range so
       * short end modules (Services / Clients) still get a real active window
       * even when their tops sit below the max marker position.
       */
      const updateActiveFromScroll = () => {
        rafId = 0;

        if (document.documentElement.classList.contains("show-visuals")) {
          applyActive("visuals");
          return;
        }

        const vh = window.innerHeight;
        const docHeight = document.documentElement.scrollHeight;
        const maxScroll = Math.max(0, docHeight - vh);
        const scrollY = window.scrollY;
        const markerRatio = 0.4;
        const minGap = Math.min(120, Math.max(48, maxScroll / (sections.length * 2)));

        const tops = sections.map(
          (section) => section.getBoundingClientRect().top + scrollY
        );

        // Raw: scrollY when the section top hits the marker line
        const thresholds = tops.map((top, i) =>
          i === 0 ? 0 : top - vh * markerRatio
        );

        // Keep thresholds inside [0, maxScroll] and strictly increasing so
        // every section (especially the last ones) is reachable before EOF.
        // Leave (n - i) * minGap of scroll for this section and those after it.
        thresholds[0] = 0;
        for (let i = 1; i < thresholds.length; i++) {
          const maxAllowed = Math.max(0, maxScroll - (thresholds.length - i) * minGap);
          thresholds[i] = Math.min(
            Math.max(thresholds[i], thresholds[i - 1] + minGap),
            maxAllowed
          );
        }

        let activeIndex = 0;
        for (let i = 0; i < thresholds.length; i++) {
          if (scrollY >= thresholds[i]) activeIndex = i;
        }

        applyActive(sections[activeIndex].id);
      };

      scheduleUpdate = () => {
        if (rafId) return;
        rafId = window.requestAnimationFrame(updateActiveFromScroll);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true, signal });
      window.addEventListener(
        "resize",
        () => {
          lastActiveId = null;
          syncActiveUnderline();
          scheduleUpdate();
        },
        { signal }
      );
      window.addEventListener(
        "load",
        () => {
          lastActiveId = null;
          scheduleUpdate();
        },
        { signal }
      );

      // Keep spy correct as images/fonts change section tops
      const layoutRoot = document.querySelector(".homepage__container");
      if (layoutRoot && typeof ResizeObserver !== "undefined") {
        const ro = new ResizeObserver(() => {
          lastActiveId = null;
          scheduleUpdate();
        });
        ro.observe(layoutRoot);
        signal.addEventListener("abort", () => ro.disconnect());
      }

      scheduleUpdate();
    }
  };

  document.addEventListener("astro:page-load", bootNav);
</script>
