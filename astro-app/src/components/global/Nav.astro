---
import Book from "./Book.astro";
import BookVisuals from "./BookVisuals.astro";

interface NavItem {
  id: string;
  label: string;
  order: number;
}

interface Props {
  items?: NavItem[];
}

const { items = [] } = Astro.props;

const fallbackItems: NavItem[] = [
  { id: "about-apn", label: "About APN", order: 1 },
  { id: "contact", label: "Contact", order: 2 },
  { id: "latest-project", label: "Latest Project", order: 3 },
  { id: "table-of-works", label: "Table of Works", order: 4 },
  { id: "services-team", label: "Services & Team", order: 5 },
  { id: "clients-collaborators", label: "Clients & Collaborators", order: 6 },
];

const navItems = (items.length > 0 ? items : fallbackItems)
  .slice()
  .sort((a, b) => a.order - b.order);

function wordClass(words: string[], index: number): string {
  if (words.length === 1) return "";
  if (index < words.length - 1) return "nav__line-no";
  if (words.length === 2) return "nav__line-full";
  return "";
}
---

<nav>
  <menu>
    {navItems.map((item, itemIndex) => {
      const words = item.label.trim().split(/\s+/).filter(Boolean);
      const num = String(itemIndex + 1).padStart(2, "0");
      return words.map((word, wordIndex) => (
        <button
          type="button"
          data-nav-button
          data-target={item.id}
          class={wordClass(words, wordIndex)}
        >
          {wordIndex === 0 && <span class="font-xs sans">{num}</span>}
          <span class="font-s">{word}</span>
        </button>
      ));
    })}

    <button type="button" data-nav-button data-target="visuals">
      <span class="font-xs sans">{String(navItems.length + 1).padStart(2, "0")}</span>
      <span class="font-s">Visuals</span>
    </button>
  </menu>
  <div class="book__indications">
    <div data-visuals-toggle><Book /><BookVisuals /></div>
    <div class="indications font-xs sans">
      Press 'F' on your keyboard to view the featured work. Press 'T' to return to the text page.
    </div>
  </div>
</nav>

<script>
  let abortController: AbortController | null = null;

  const bootNav = () => {
    abortController?.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    const navItems = document.querySelectorAll<HTMLElement>("[data-nav-item]");
    const navButtons = document.querySelectorAll<HTMLButtonElement>("[data-nav-button]");

    const setActiveTarget = (id: string) => {
      if (navItems.length > 0) {
        navItems.forEach((item) => item.classList.remove("active"));
        const activeItem = Array.from(navItems).find((item) => item.dataset.target === id);
        activeItem?.classList.add("active");
      }

      navButtons.forEach((btn) => btn.classList.remove("active"));
      navButtons.forEach((btn) => {
        if (btn.dataset.target === id) btn.classList.add("active");
      });
    };

    let scheduleUpdate = () => {};

    navButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const targetId = button.dataset.target;
          if (!targetId) return;

          if (targetId === "visuals") {
            const root = document.documentElement;
            const wasShowing = root.classList.contains("show-visuals");
            root.classList.toggle("show-visuals");
            if (wasShowing) scheduleUpdate();
            else setActiveTarget(targetId);
            return;
          }

          document.documentElement.classList.remove("show-visuals");
          const target = document.getElementById(targetId);
          target?.scrollIntoView({ behavior: "smooth", block: "center" });
          setActiveTarget(targetId);
        },
        { signal }
      );
    });

    const toggleVisuals = () => {
      const root = document.documentElement;
      const wasShowing = root.classList.contains("show-visuals");
      root.classList.toggle("show-visuals");
      if (wasShowing) scheduleUpdate();
      else setActiveTarget("visuals");
    };

    const hideVisuals = () => {
      const root = document.documentElement;
      if (!root.classList.contains("show-visuals")) return;
      root.classList.remove("show-visuals");
      scheduleUpdate();
    };

    document.querySelectorAll<HTMLElement>("[data-visuals-toggle]").forEach((el) => {
      el.addEventListener("click", () => toggleVisuals(), { signal });
    });

    window.addEventListener(
      "keydown",
      (e) => {
        const target = e.target as HTMLElement | null;
        const tag = target?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select" || target?.isContentEditable)
          return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        const key = e.key.toLowerCase();
        if (key === "f") {
          e.preventDefault();
          toggleVisuals();
        } else if (key === "t") {
          e.preventDefault();
          hideVisuals();
        }
      },
      { signal }
    );

    const targetIds = Array.from(
      new Set(
        Array.from(navButtons)
          .map((b) => b.dataset.target)
          .filter((t): t is string => Boolean(t))
      )
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-nav-section]")
    ).filter((section) => Boolean(section.id) && targetIds.includes(section.id));

    if (sections.length > 0) {
      let rafId = 0;
      const updateActiveFromScroll = () => {
        rafId = 0;
        if (document.documentElement.classList.contains("show-visuals")) {
          setActiveTarget("visuals");
          return;
        }
        const bottomThresholdPx = 2;
        const atBottom =
          window.scrollY + window.innerHeight >=
          document.documentElement.scrollHeight - bottomThresholdPx;

        if (atBottom) {
          const lastId = sections[sections.length - 1]?.id ?? null;
          if (lastId) setActiveTarget(lastId);
          return;
        }

        const centerY = window.scrollY + window.innerHeight / 2;

        let activeId: string | null = null;
        sections.forEach((section) => {
          const top = section.offsetTop;
          if (top <= centerY) activeId = section.id;
        });

        if (!activeId) activeId = sections[0]?.id ?? null;
        if (activeId) setActiveTarget(activeId);
      };

      scheduleUpdate = () => {
        if (rafId) return;
        rafId = window.requestAnimationFrame(updateActiveFromScroll);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true, signal });
      window.addEventListener("resize", scheduleUpdate, { signal });
      scheduleUpdate();
    }
  };

  document.addEventListener("astro:page-load", bootNav);
</script>
