---
import type { InferGetStaticParamsType } from "astro";
import Layout from "../../layouts/Layout.astro";
import '../../styles/pages/project.css';
import { getProject, getProjects } from "../../utils/sanity";
import { urlFor } from "../../utils/image";
import type { ImageAsset } from "@sanity/types";
import type { FileAsset } from "../../utils/sanity";
import SanityImage from "../../components/SanityImage.astro";
import PortableText from "../../components/PortableText.astro";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .map((p) => p.slug?.current)
    .filter((s): s is string => Boolean(s))
    .map((slug) => ({ params: { slug } }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;

const project = await getProject(slug);
---

<Layout title={project?.title ?? "Project"}>
  <section class="project">
    <div class="project__container">
      {project?.title && (
        <div class="project__title-sticky">
          <h1 class="project__title font-s small-caps">{project.title}</h1>
        </div>
      )}

      {project?.projectType !== "extended" && project?.regularMedia && project.regularMedia.length > 0 && (
        <>
          <div class="project__media">
            {project.regularMedia.map((mediaItem) => {
              if (mediaItem._type === "image" && "asset" in mediaItem && mediaItem.asset) {
                const dims = (mediaItem as { dimensions?: { width?: number; height?: number } }).dimensions;
                const w = dims?.width ?? 0;
                const h = dims?.height ?? 0;
                const ratio = w > 0 && h > 0 ? w / h : 0;
                const aspect = ratio > 0 ? String(ratio) : undefined;
                const orientation =
                  w > 0 && h > 0 ? (w > h ? "landscape" : h > w ? "portrait" : "square") : undefined;
                const xLandscape = orientation === "landscape" && ratio > 1.45;
                const xPortrait = orientation === "portrait" && ratio > 0 && ratio < 0.6;
                return (
                  <div
                    class={`project__image${orientation ? ` ${orientation}` : ""}${xLandscape ? " x-landscape" : ""}${xPortrait ? " x-portrait" : ""}`}
                    data-project-slide="image"
                    data-aspect={aspect}
                  >
                    <SanityImage
                      image={mediaItem as any}
                      alt={mediaItem.alt || project.title || ""}
                      width={1600}
                      sizes="(max-width: 768px) 100vw, min(100vw, 1600px)"
                      loading="lazy"
                      class="project__image-element media-element"
                    />
                  </div>
                );
              }
              if (mediaItem._type === "file" && mediaItem.asset && "url" in mediaItem.asset) {
                const fileAsset = mediaItem.asset as FileAsset;
                let posterUrl: string | undefined;
                if (mediaItem.poster && mediaItem.poster.asset) {
                  posterUrl = urlFor(mediaItem.poster.asset as ImageAsset).width(2400).url();
                }
                return (
                  <div class="project__video" data-project-slide="video">
                    <video
                      autoplay
                      loop
                      preload="metadata"
                      muted
                      playsinline
                      class="project__video-element media-element"
                      poster={posterUrl}
                    >
                      <source src={fileAsset.url} type={fileAsset.mimeType || "video/mp4"} />
                      Your browser does not support the video tag.
                    </video>
                  </div>
                );
              }
              return null;
            })}
            <div class="project__credits-container" data-project-slide="credits">
              <div class="project__credits-separator">
                <span class="project__credits-separator-text font-l">* * *</span>
              </div>

              <dl class="project__credits font-s">
                {(project?.year ||
                  project?.client ||
                  project?.designedBy ||
                  project?.typeface ||
                  project?.animationBy ||
                  project?.location ||
                  project?.techStack ||
                  project?.services) && (
                    <>
                      {project?.year && (
                        <div class="project__credit">
                          <dt class="small-caps">Year</dt>
                          <dd>{project.year}</dd>
                        </div>
                      )}
                      {project?.client && (
                        <div class="project__credit">
                          <dt class="small-caps">Client</dt>
                          <dd>{project.client}</dd>
                        </div>
                      )}
                      {project?.designedBy && (
                        <div class="project__credit">
                          <dt class="small-caps">Designed By</dt>
                          <dd>{project.designedBy}</dd>
                        </div>
                      )}
                      {project?.typeface && (
                        <div class="project__credit">
                          <dt class="small-caps">Typeface</dt>
                          <dd>{project.typeface}</dd>
                        </div>
                      )}
                      {project?.animationBy && (
                        <div class="project__credit">
                          <dt class="small-caps">Animation By</dt>
                          <dd>{project.animationBy}</dd>
                        </div>
                      )}
                      {project?.location && (
                        <div class="project__credit">
                          <dt class="small-caps">Located In</dt>
                          <dd>{project.location}</dd>
                        </div>
                      )}
                      {project?.techStack && (
                        <div class="project__credit">
                          <dt class="small-caps">Tech Stack</dt>
                          <dd>{project.techStack}</dd>
                        </div>
                      )}
                      {project?.services && (
                        <div class="project__credit">
                          <dt class="small-caps">Services</dt>
                          <dd>{project.services}</dd>
                        </div>
                      )}
                      {project?.customCredits &&
                        project.customCredits.length > 0 &&
                        project.customCredits.map((credit) => (
                          <div class="project__credit">
                            {credit.credit && <dt class="small-caps">{credit.credit}</dt>}
                            {credit.text && (
                              <dd>
                                <PortableText content={credit.text} />
                              </dd>
                            )}
                          </div>
                        ))}
                    </>
                )}
              </dl>

              {project?.links && project.links.length > 0 && (
                <div class="project__links sans font-s">
                  <PortableText content={project.links} />
                </div>
              )}

            </div>
          </div>
        </>
      )}

    </div>
  </section>
</Layout>

<script>
  /**
   * Scroll overlap stack — tune opacity here only.
   *
   * Stage A — next slide enters the fade band: this slide lerps `opacityFront` → `opacityBehindNext`
   * (or → `opacityGone` when the next slide is credits). For credits-adjacent slides, progress is also
   * eased by `creditsScrollTail*` over the **last** chunk of document scroll so opacity reaches 0
   * smoothly (sticky `top` alone can plateau before scroll ends).
   *
   * Stage B — two-ahead slide drives `opacity → opacityGone`. By default this is **much shorter** than
   * stage A so the back slide is basically gone **before** the third sits on the second; tune with
   * `stageBSpanMultiplier`, `stageBLeadBoostPx`, and `stageBFinishProgress`.
   */
  const SCROLL_FADE = {
    opacityFront: 1,
    opacityBehindNext: 0.2,
    opacityGone: 0,

    /** Pause `<video>` when wrapper opacity is at or below this (set between `opacityBehindNext` and `opacityGone`). */
    videoPauseOpacityThreshold: 0.11,

    /** Reference line from viewport top (fraction of `innerHeight`). */
    startYRatio: 0.71,
    fadeLeadRatio: 0.028,
    fadeLeadMinPx: 10,
    /** Larger = longer / gentler ramp for stage A. */
    startYSpanFactor: 0.92,

    /**
     * Raw stage-A progress is divided by this (then clamped) so opacity reaches the stage-A floor
     * (`opacityBehindNext`, or `opacityGone` when the next slide is credits) in less scroll distance.
     * Use `1` to disable remapping (matches the mathematical end of the band).
     */
    stageAFinishProgress: 0.88,

    /**
     * Stage B band length vs stage A (`0.22` ≈ 5× faster full raw progress than `1`).
     * Smaller = shorter scroll until the two-ahead slide has crossed the band.
     */
    stageBSpanMultiplier: 0.22,
    /**
     * Extra pixels added to the fade “lead” **only** for the two-ahead measurement — starts stage B
     * earlier so the first slide clears before the third stacks on the second.
     */
    stageBLeadBoostPx: 96,
    /**
     * Raw stage-B progress is divided by this (then clamped) so opacity hits `opacityGone` before the
     * mathematical end of the band — no long tail of values like `0.026`. Use `1` to disable remapping.
     */
    stageBFinishProgress: 0.88,

    /** Treat opacity at or below `opacityGone + pointerEventsGoneEpsilon` as non-interactive. */
    pointerEventsGoneEpsilon: 0.02,

    /**
     * Last segment of `scrollHeight`: linear 0→1 blend merged with stage A / B when the next or
     * two-ahead slide is credits (avoids a hard jump to full fade-out at max scroll).
     */
    creditsScrollTailMinPx: 200,
    creditsScrollTailVhFraction: 0.48,
  } as const;

  function clamp01(n: number): number {
    return Math.max(0, Math.min(1, n));
  }

  type ProjectPageDom = {
    container: HTMLElement;
    title: HTMLElement | null;
    media: HTMLElement;
    slides: HTMLElement[];
  };

  /** Any `[data-project-slide]` under `.project__media` gets sticky `top` + scroll opacity (add blocks like credits). */
  const SLIDE_SELECTOR = ".project__media [data-project-slide]";

  /** Fresh query each time — needed for `ClientRouter` / `astro:page-load`. */
  function getProjectPageDom(): ProjectPageDom | null {
    const container = document.querySelector<HTMLElement>(".project__container");
    const media = document.querySelector<HTMLElement>(".project__media");
    if (!container || !media) return null;
    const title = document.querySelector<HTMLElement>(".project__title");
    const slides = Array.from(document.querySelectorAll<HTMLElement>(SLIDE_SELECTOR));
    return { container, title, media, slides };
  }

  /**
   * Credits: measure intrinsic border-box height (bottom margin cleared), then
   * `margin-bottom = (vh − h) / 2` so scroll extent matches the old padding approach without
   * bloating the sticky border box (which broke fade `top` progress for the previous slide).
   * Does not set `padding-top` / `padding-bottom` (sticky `top` comes from `applyTitlePaddingAndStickyTops`).
   */
  function applyCreditsSlideViewportPadding(el: HTMLElement, vh: number): void {
    if (el.dataset.projectSlide !== "credits") return;
    el.style.paddingBottom = "";
    el.style.marginBottom = "0";
    void el.offsetHeight;
    const h = el.getBoundingClientRect().height;
    const x = Math.max(0, Math.round((vh - h) / 2));
    el.style.marginBottom = `${x}px`;
  }

  function measureTitleClearancePx(title: HTMLElement | null): number {
    const titleHeight = title ? Math.ceil(title.getBoundingClientRect().height) : 0;
    return titleHeight > 0 ? titleHeight + 8 : 0;
  }

  /** Sets `--project-title-offset` and each slide’s sticky `style.top`. */
  function applyTitlePaddingAndStickyTops(ctx: ProjectPageDom): void {
    const { container, title, slides } = ctx;
    const vh = window.innerHeight;
    if (vh <= 0) return;

    const baseOffset = measureTitleClearancePx(title);

    if (slides.length === 0) {
      container.style.setProperty("--project-title-offset", `${baseOffset}px`);
      return;
    }

    const h0 = slides[0]!.getBoundingClientRect().height;
    const firstCenterTop = h0 > 0 ? Math.max(0, (vh - h0) / 2) : 0;
    const padTop = Math.max(baseOffset, Math.round(firstCenterTop));
    container.style.setProperty("--project-title-offset", `${padTop}px`);

    for (const el of slides) {
      applyCreditsSlideViewportPadding(el, vh);
    }

    for (let i = 0; i < slides.length; i++) {
      const el = slides[i]!;
      const h = el.getBoundingClientRect().height;
      if (h <= 0) continue;
      const centered = Math.max(0, (vh - h) / 2);
      const top = i === 0 ? Math.max(baseOffset, centered) : centered;
      el.style.top = `${Math.round(top)}px`;
    }
  }

  /** Play / pause embedded videos from each wrapper’s computed opacity (and tab visibility). */
  function syncVideosToSlideOpacity(wrappers: HTMLElement[]): void {
    if (document.hidden) {
      for (const el of wrappers) {
        const video = el.querySelector("video");
        if (video && !video.paused) video.pause();
      }
      return;
    }
    const t = SCROLL_FADE.videoPauseOpacityThreshold;
    for (const el of wrappers) {
      const video = el.querySelector("video");
      if (!video) continue;
      const opacity = parseFloat(window.getComputedStyle(el).opacity) || 0;
      if (opacity < t) {
        if (!video.paused) video.pause();
      } else if (video.paused) {
        void video.play().catch(() => {});
      }
    }
  }

  function clearSlideOpacityAndPointerEvents(wrappers: HTMLElement[]): void {
    for (const el of wrappers) {
      el.style.opacity = "";
      el.style.pointerEvents = "";
    }
    syncVideosToSlideOpacity(wrappers);
  }

  function getFadeBandGeometry(vh: number): {
    startY: number;
    fadeLeadPx: number;
    fadeSpanA: number;
    fadeSpanB: number;
  } {
    const startY = vh * SCROLL_FADE.startYRatio;
    const fadeLeadPx = Math.max(SCROLL_FADE.fadeLeadMinPx, vh * SCROLL_FADE.fadeLeadRatio);
    const fadeSpanA = Math.max(1, startY * SCROLL_FADE.startYSpanFactor) + fadeLeadPx;
    const fadeSpanB = fadeSpanA * SCROLL_FADE.stageBSpanMultiplier;
    return { startY, fadeLeadPx, fadeSpanA, fadeSpanB };
  }

  /** `0` = before band, `1` = fully through band, as `top` moves upward through the fade zone. */
  function overlapBandProgress(top: number, startY: number, fadeLeadPx: number, span: number): number {
    return clamp01((startY + fadeLeadPx - top) / span);
  }

  /** Linear 0→1 as `scrollY` moves through the last `zonePx` of the document (clamped to `maxScroll`). */
  function scrollTailProgress01(zonePx: number): number {
    if (zonePx <= 0) return 0;
    const root = document.scrollingElement ?? document.documentElement;
    const y = window.scrollY;
    const maxY = Math.max(0, root.scrollHeight - window.innerHeight);
    if (maxY <= 0) return 1;
    const zone = Math.min(zonePx, maxY);
    const start = maxY - zone;
    if (y <= start) return 0;
    return clamp01((y - start) / zone);
  }

  /** One scroll frame: mutates `opacity` / `pointerEvents` on each slide, then syncs videos. */
  function applyScrollOpacityToSlides(slides: HTMLElement[]): void {
    const vh = window.innerHeight || 0;
    if (vh <= 0 || slides.length === 0) return;

    const { startY, fadeLeadPx, fadeSpanA, fadeSpanB } = getFadeBandGeometry(vh);
    const tops = slides.map((el) => el.getBoundingClientRect().top);
    const tailZonePx = Math.round(
      Math.max(SCROLL_FADE.creditsScrollTailMinPx, vh * SCROLL_FADE.creditsScrollTailVhFraction),
    );
    const scrollTail = scrollTailProgress01(tailZonePx);

    const { opacityFront, opacityBehindNext, opacityGone } = SCROLL_FADE;
    const stageADenom = Math.max(0.05, SCROLL_FADE.stageAFinishProgress);

    for (let i = 0; i < slides.length; i++) {
      const el = slides[i]!;
      const nextEl = slides[i + 1];
      const twoAheadEl = slides[i + 2];
      const nextTop = tops[i + 1];
      const twoAheadTop = tops[i + 2];
      const nextIsCredits = nextEl?.dataset.projectSlide === "credits";
      const twoAheadIsCredits = twoAheadEl?.dataset.projectSlide === "credits";
      const stageAFloor = nextIsCredits ? opacityGone : opacityBehindNext;

      const pNextRaw = nextTop !== undefined ? overlapBandProgress(nextTop, startY, fadeLeadPx, fadeSpanA) : 0;
      let pNext = clamp01(pNextRaw / stageADenom);
      if (nextIsCredits) pNext = Math.max(pNext, scrollTail);

      let oA: number;
      if (pNext <= 0) oA = opacityFront;
      else if (pNext >= 1) oA = stageAFloor;
      else oA = opacityFront + (stageAFloor - opacityFront) * pNext;

      const leadB = fadeLeadPx + SCROLL_FADE.stageBLeadBoostPx;
      const pTwoRaw =
        twoAheadTop !== undefined ? overlapBandProgress(twoAheadTop, startY, leadB, fadeSpanB) : 0;
      const finish = Math.max(0.05, Math.min(1, SCROLL_FADE.stageBFinishProgress));
      let pTwo = clamp01(pTwoRaw / finish);
      if (twoAheadIsCredits) pTwo = Math.max(pTwo, scrollTail);

      let o: number;
      if (pTwo <= 0) o = oA;
      else if (pTwo >= 1) o = opacityGone;
      else o = oA + (opacityGone - oA) * pTwo;

      el.style.opacity = String(o);
      el.style.pointerEvents = o <= opacityGone + SCROLL_FADE.pointerEventsGoneEpsilon ? "none" : "";
    }
    syncVideosToSlideOpacity(slides);
  }

  function runScrollOpacityPass(
    slides: HTMLElement[],
    reduceMotion: MediaQueryList,
    isDisposed: () => boolean,
  ): void {
    if (isDisposed()) return;
    if (reduceMotion.matches) {
      clearSlideOpacityAndPointerEvents(slides);
      return;
    }
    if (window.scrollY <= 0) {
      for (const el of slides) {
        el.style.opacity = String(SCROLL_FADE.opacityFront);
        el.style.pointerEvents = "";
      }
      syncVideosToSlideOpacity(slides);
      return;
    }
    applyScrollOpacityToSlides(slides);
  }

  function createRafSlot(isDisposed: () => boolean, run: () => void) {
    let id = 0;
    return {
      schedule() {
        if (isDisposed() || id) return;
        id = window.requestAnimationFrame(() => {
          id = 0;
          if (isDisposed()) return;
          run();
        });
      },
      cancel() {
        if (id) window.cancelAnimationFrame(id);
        id = 0;
      },
    };
  }

  type ListenerBundle = {
    reduceMotion: MediaQueryList;
    onReduceMotionChange: () => void;
    onScroll: () => void;
    onResize: () => void;
    onVisibility: () => void;
    resizeObserver: ResizeObserver | undefined;
  };

  function attachProjectPageListeners(
    ctx: ProjectPageDom,
    layout: ReturnType<typeof createRafSlot>,
    opacity: ReturnType<typeof createRafSlot>,
    reduceMotion: MediaQueryList,
  ): ListenerBundle {
    const onReduceMotionChange = () => {
      if (reduceMotion.matches) {
        opacity.cancel();
        clearSlideOpacityAndPointerEvents(ctx.slides);
      } else {
        opacity.schedule();
      }
    };

    const onScroll = () => opacity.schedule();
    const onResize = () => {
      layout.schedule();
      opacity.schedule();
    };
    const onVisibility = () => {
      if (reduceMotion.matches) {
        syncVideosToSlideOpacity(ctx.slides);
        return;
      }
      opacity.schedule();
    };

    reduceMotion.addEventListener("change", onReduceMotionChange);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    document.addEventListener("visibilitychange", onVisibility);

    let resizeObserver: ResizeObserver | undefined;
    if (typeof ResizeObserver !== "undefined") {
      resizeObserver = new ResizeObserver(() => layout.schedule());
      resizeObserver.observe(ctx.media);
    }

    return {
      reduceMotion,
      onReduceMotionChange,
      onScroll,
      onResize,
      onVisibility,
      resizeObserver,
    };
  }

  function detachProjectPageListeners(bundle: ListenerBundle): void {
    bundle.reduceMotion.removeEventListener("change", bundle.onReduceMotionChange);
    window.removeEventListener("scroll", bundle.onScroll);
    window.removeEventListener("resize", bundle.onResize);
    document.removeEventListener("visibilitychange", bundle.onVisibility);
    bundle.resizeObserver?.disconnect();
  }

  /**
   * Wire layout + scroll opacity for the project gallery.
   * Returns teardown for view transitions and navigation away.
   */
  function setupProjectPage(): () => void {
    const ctx = getProjectPageDom();
    if (!ctx) return () => {};

    let disposed = false;
    const isDisposed = () => disposed;

    const layoutRaf = createRafSlot(isDisposed, () => applyTitlePaddingAndStickyTops(ctx));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const opacityRaf = createRafSlot(isDisposed, () =>
      runScrollOpacityPass(ctx.slides, reduceMotion, isDisposed),
    );

    const listeners = attachProjectPageListeners(ctx, layoutRaf, opacityRaf, reduceMotion);

    applyTitlePaddingAndStickyTops(ctx);
    void document.fonts?.ready.then(() => {
      if (!isDisposed()) layoutRaf.schedule();
    });

    if (reduceMotion.matches) clearSlideOpacityAndPointerEvents(ctx.slides);
    else opacityRaf.schedule();

    return () => {
      disposed = true;
      detachProjectPageListeners(listeners);
      layoutRaf.cancel();
      opacityRaf.cancel();
      clearSlideOpacityAndPointerEvents(ctx.slides);
      for (const el of ctx.slides) {
        if (el.dataset.projectSlide === "credits") {
          el.style.paddingBottom = "";
          el.style.marginBottom = "";
        }
      }
    };
  }

  let teardownProjectPage: () => void = () => {};

  function bootProjectPage(): void {
    teardownProjectPage();
    teardownProjectPage = setupProjectPage();
  }

  document.addEventListener("astro:page-load", bootProjectPage);
  bootProjectPage();
</script>

