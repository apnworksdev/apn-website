---
import Layout from "../layouts/Layout.astro";
import { getHomepage, getFeaturedCarousel } from "../utils/sanity";
import HomeLayer from "../components/HomeLayer.astro";
import "../styles/pages/homepage.css";
import "../styles/pages/featuredCarousel.css";
import PortableText from "../components/PortableText.astro";
import FirstLetterStrong from "../components/FirstLetterStrong.astro";
import SanityImage from "../components/SanityImage.astro";
import type { Image, ImageAsset } from "@sanity/types";
import { urlFor } from "../utils/image";

const homepage = await getHomepage();
const featuredCarousel = await getFeaturedCarousel();
const homepageModules = homepage?.modules ?? [];
const slugifyForId = (value: string) =>
  value
    .trim()
    .toLowerCase()
    .replace(/['"]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const moduleSectionIds = homepageModules.map((module, index) => {
  const fromMenuLink = module.menuLink ? slugifyForId(module.menuLink) : "";
  return (
    fromMenuLink ||
    `module-${index + 1}-${module._key.replace(/[^a-zA-Z0-9_-]/g, "")}`
  );
});
const navItems = homepageModules
  .map((module, index) => {
    const label = module.menuLink?.trim();
    return label
      ? {
          id: moduleSectionIds[index],
          label,
        }
      : null;
  })
  .filter((item): item is { id: string; label: string } => Boolean(item));
const orderedNavItems = navItems.map((item, index) => ({
  ...item,
  order: index + 1,
}));

const heroModule = homepageModules.find((m) => m._type === "hero");
const ogImage =
  heroModule && heroModule._type === "hero" && heroModule.image
    ? urlFor(heroModule.image).width(1200).url()
    : undefined;
---

<Layout
  title="APN"
  description="APN — Design & Development studio"
  ogImage={ogImage}
  navItems={orderedNavItems}
>
  {homepage ? <HomeLayer homepage={homepage} /> : null}

  <div
    class="featured-carousel__container"
    data-carousel
    data-count={featuredCarousel?.modules?.length ?? 0}
  >
    {featuredCarousel?.modules &&
      featuredCarousel.modules.length > 0 &&
      featuredCarousel.modules.map((item, index) => {
        const firstMedia = item.media?.[0];
        const isImage = firstMedia?._type === "image" && Boolean(firstMedia?.asset);
        const isFile =
          firstMedia?._type === "file" && firstMedia?.asset && "url" in firstMedia.asset;
        const href = item.project?.slug?.current
          ? `/project/${item.project.slug.current}`
          : undefined;
        const dims =
          isImage && firstMedia && "dimensions" in firstMedia
            ? (firstMedia as { dimensions?: { width?: number; height?: number } }).dimensions
            : firstMedia?._type === "file" && firstMedia?.poster?.asset
              ? (
                  firstMedia.poster.asset as {
                    metadata?: { dimensions?: { width?: number; height?: number } };
                  }
                ).metadata?.dimensions
              : undefined;
        const w = dims?.width ?? 0;
        const h = dims?.height ?? 0;
        const mediaOrientation =
          w > 0 && h > 0 ? (w > h ? "landscape" : h > w ? "portrait" : "square") : "square";
        return (
          <div
            class={`featured-carousel__item${index === 0 ? " active" : ""}`}
            data-index={index}
            data-rotation={item.rotation ?? "default"}
            data-media-orientation={mediaOrientation}
          >
            <div class="featured-carousel__item__content">
              {isImage && firstMedia?.asset && (
                <SanityImage
                  class="featured-carousel__media"
                  image={firstMedia as unknown as Image}
                  alt={firstMedia.alt ?? item.project?.title ?? ""}
                  width={1600}
                  sizes="(max-width: 768px) 100vw, min(90vw, 1600px)"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              )}
              {isFile && firstMedia?.asset && "url" in firstMedia.asset && (
                <video
                  src={firstMedia.asset.url}
                  poster={
                    firstMedia.poster?.asset && !("url" in firstMedia.poster.asset)
                      ? urlFor(firstMedia.poster.asset as ImageAsset).width(1600).url()
                      : undefined
                  }
                  preload="metadata"
                  muted
                  playsinline
                  controls
                />
              )}

              <div class="featured-carousel__item__text font-m small-caps">
                {href ? (
                  <a href={href}>
                    {item.label && item.label.length > 0 ? (
                      <PortableText content={item.label} strongFirstLetters />
                    ) : item.project?.title ? (
                      <h3>
                        <FirstLetterStrong text={item.project.title} />
                      </h3>
                    ) : null}
                  </a>
                ) : item.label && item.label.length > 0 ? (
                  <PortableText content={item.label} strongFirstLetters />
                ) : item.project?.title ? (
                  <h3>
                    <FirstLetterStrong text={item.project.title} />
                  </h3>
                ) : null}
              </div>
            </div>
          </div>
        );
      })}
  </div>

  <script>
    let abortController: AbortController | null = null;

    const bootCarousel = () => {
      abortController?.abort();
      abortController = new AbortController();
      const { signal } = abortController;

      const container = document.querySelector(".featured-carousel__container[data-carousel]");
      if (!container) return;

      const count = parseInt(container.getAttribute("data-count") ?? "0", 10);
      const items = container.querySelectorAll(".featured-carousel__item");
      if (count <= 0 || items.length === 0) return;

      const setActiveIndex = (nextIndex: number) => {
        const current = container.querySelector(".featured-carousel__item.active");
        current?.classList.remove("active");
        items[nextIndex]?.classList.add("active");
      };

      const getCurrentIndex = () => {
        const current = container.querySelector(".featured-carousel__item.active");
        return current ? parseInt((current as HTMLElement).dataset.index ?? "0", 10) : 0;
      };

      container.addEventListener(
        "click",
        (e) => {
          const target = e.target as Element | null;
          if (!target || target.closest("a")) return;
          if (!target.closest(".featured-carousel__item__content")) {
            if (document.documentElement.classList.contains("show-visuals")) {
              document.documentElement.classList.remove("show-visuals");
              window.dispatchEvent(new Event("resize"));
            }
            return;
          }
          const currentIndex = getCurrentIndex();
          const nextIndex = (currentIndex + 1) % count;
          setActiveIndex(nextIndex);
        },
        { signal }
      );

      window.addEventListener(
        "keydown",
        (e) => {
          const target = e.target as HTMLElement | null;
          const tag = target?.tagName?.toLowerCase();
          if (
            tag === "input" ||
            tag === "textarea" ||
            tag === "select" ||
            target?.isContentEditable
          )
            return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;

          if (e.key === "ArrowRight") {
            e.preventDefault();
            const currentIndex = getCurrentIndex();
            const nextIndex = (currentIndex + 1) % count;
            setActiveIndex(nextIndex);
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            const currentIndex = getCurrentIndex();
            const prevIndex = (currentIndex - 1 + count) % count;
            setActiveIndex(prevIndex);
          }
        },
        { signal }
      );
    };

    document.addEventListener("astro:page-load", bootCarousel);
  </script>
</Layout>
